# MTA Agents Demo — environment configuration
# Copy this file to .env and fill in the values for your target cluster.
# deploy.sh and validate.sh source .env automatically.
# Never commit .env to git.

# ─── OpenShift cluster ─────────────────────────────────────────────────────────

# Safety guard: deploy.sh and validate.sh refuse to run unless the current
# oc api server URL contains this substring. Set it to a unique part of your
# cluster API URL (e.g. the cluster name or a domain fragment) to prevent
# accidentally deploying to the wrong cluster.
RHOAI_EXPECTED_API_SERVER=

# Full API server URL for convenience (used in the login hint printed at the end)
OPENSHIFT_API_URL=

# ─── Git source (required for Argo CD Application) ─────────────────────────────

# Fork this repo and set GIT_REPO_URL to your fork. Argo CD must be able to
# reach this URL from inside the cluster (use HTTPS, not SSH, for public repos).
GIT_REPO_URL=https://github.com/<your-org>/mta-agents-demo.git
GIT_REPO_BRANCH=main

# ─── LLM Gateways ──────────────────────────────────────────────────────────────
# Define one or more LLM gateways using indexed env vars (GATEWAY_1_*, GATEWAY_2_*, …).
# deploy.sh iterates i=1, 2, … until GATEWAY_${i}_NAME is empty, then stops.
# For each gateway it:
#   1. Creates the Secret <GATEWAY_N_NAME>-credentials in openshift-mta.
#   2. Applies the Gateway CR from llm-gateway/gateway-template.yaml via envsubst.
# Add GATEWAY_2_* (and so on) to register more gateways without any git changes.
#
# GATEWAY_N_NAME         — CR name and credential Secret name prefix.
#                          Must be a valid Kubernetes name (lowercase, hyphens).
# GATEWAY_N_ENDPOINT     — Base URL of the OpenAI-compatible endpoint, WITHOUT the
#                          /v1 suffix. The agentic-controller appends it automatically.
# GATEWAY_N_MODEL_ID     — Model identifier as served by the endpoint (must match
#                          the name returned by GET /v1/models).
# GATEWAY_N_CONTEXT_WINDOW — Integer token context window (e.g. 131072).
#                            Adjust to match the model's --max-model-len in vLLM.
# GATEWAY_N_API_KEY      — API key. Leave empty for unauthenticated endpoints.
#                          The value is never committed to git.
# GATEWAY_N_TIER         — Gateway tier label (standard | premium). Defaults to standard.

GATEWAY_1_NAME=qwen-external
GATEWAY_1_ENDPOINT=
GATEWAY_1_MODEL_ID=
GATEWAY_1_CONTEXT_WINDOW=131072
GATEWAY_1_API_KEY=
GATEWAY_1_TIER=standard

# Second gateway example (uncomment and fill to enable):
# GATEWAY_2_NAME=openai-gpt4o
# GATEWAY_2_ENDPOINT=https://api.openai.com
# GATEWAY_2_MODEL_ID=gpt-4o
# GATEWAY_2_CONTEXT_WINDOW=128000
# GATEWAY_2_API_KEY=
# GATEWAY_2_TIER=standard

# ─── GitLab instance ───────────────────────────────────────────────────────────

# Initial password for the GitLab root (admin) account.
# deploy.sh provisions this into the gitlab-initial-root-password Secret.
# The value is never committed to git.
# After deploy, retrieve the GitLab URL with:
#   oc get route -n gitlab | grep webservice
GITLAB_ROOT_PASSWORD=

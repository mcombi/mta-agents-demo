# MTA Agents Demo — environment configuration
# Copy this file to .env and fill in the values for your target cluster.
# deploy.sh and validate.sh source .env automatically.
# Never commit .env to git.

# ─── OpenShift cluster ─────────────────────────────────────────────────────────

# Safety guard: deploy.sh and validate.sh refuse to run unless the current
# oc api server URL contains this substring. Set it to a unique part of your
# cluster API URL (e.g. the cluster name or a domain fragment) to prevent
# accidentally deploying to the wrong cluster.
RHOAI_EXPECTED_API_SERVER=

# Full API server URL for convenience (used in the login hint printed at the end)
OPENSHIFT_API_URL=

# ─── Git source (required for Argo CD Application) ─────────────────────────────

# Fork this repo and set GIT_REPO_URL to your fork. Argo CD must be able to
# reach this URL from inside the cluster (use HTTPS, not SSH, for public repos).
GIT_REPO_URL=https://github.com/<your-org>/mta-agents-demo.git
GIT_REPO_BRANCH=main

# ─── Qwen endpoint ─────────────────────────────────────────────────────────────

# Base URL of your self-hosted Qwen endpoint, WITHOUT the /v1 suffix.
# The MTA agentic-controller appends /v1/chat/completions automatically.
# Example: https://qwen.internal.example.com
QWEN_ENDPOINT_URL=

# The model identifier as served by the endpoint (must match the model name
# returned by GET /v1/models). Example: qwen3-8b-instruct
QWEN_MODEL_ID=

# Token context window of the model deployment (--max-model-len in vLLM).
# Common values: 32768, 131072, 262144. Adjust to match your deployment.
QWEN_CONTEXT_WINDOW=131072

# API key for the endpoint. Leave empty if the endpoint is unauthenticated
# (e.g. a cluster-internal service with no auth). deploy.sh provisions this
# into the mta-qwen-credentials Secret; the value is never committed.
QWEN_API_KEY=
